37806>>>    Procedure SetActionButtons
37809>>>        tWebNavigateData NavigateData
37809>>>        tWebNavigateData NavigateData
37809>>>        Boolean bHasRecord
37809>>>        Handle hoDD
37809>>>
37809>>>        Get Server to hoDD
37810>>>        Get GetNavigateData to NavigateData
37811>>>        Get HasRecord of hoDD to bHasRecord
37812>>>
37812>>>        // let's hide all buttons and then Show the ones we want
37812>>>        WebSet pbRender of oEditBtn to False
37813>>>        WebSet pbRender of oSaveBtn to False
37814>>>        WebSet pbRender of oCancelChangesBtn to False
37815>>>        WebSet pbRender of oDeleteBtn to False
37816>>>
37816>>>        If (NavigateData.bReadOnly) Begin
37818>>>            WebSet pbRender of oEditBtn to True
37819>>>        End
37819>>>>
37819>>>        Else Begin
37820>>>            WebSet pbRender of oSaveBtn to True
37821>>>            WebSet pbRender of oCancelChangesBtn to True
37822>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37823>>>        End
37823>>>>
37823>>>    End_Procedure

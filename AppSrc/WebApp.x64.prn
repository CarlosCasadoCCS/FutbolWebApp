38420>>>    Procedure SetActionButtons
38423>>>        tWebNavigateData NavigateData
38423>>>        tWebNavigateData NavigateData
38423>>>        Boolean bHasRecord
38423>>>        Handle hoDD
38423>>>
38423>>>        Get Server to hoDD
38424>>>        Get GetNavigateData to NavigateData
38425>>>        Get HasRecord of hoDD to bHasRecord
38426>>>
38426>>>        // let's hide all buttons and then Show the ones we want
38426>>>        WebSet pbRender of oEditBtn to False
38427>>>        WebSet pbRender of oSaveBtn to False
38428>>>        WebSet pbRender of oCancelChangesBtn to False
38429>>>        WebSet pbRender of oDeleteBtn to False
38430>>>
38430>>>        If (NavigateData.bReadOnly) Begin
38432>>>            WebSet pbRender of oEditBtn to True
38433>>>        End
38433>>>>
38433>>>        Else Begin
38434>>>            WebSet pbRender of oSaveBtn to True
38435>>>            WebSet pbRender of oCancelChangesBtn to True
38436>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38437>>>        End
38437>>>>
38437>>>    End_Procedure

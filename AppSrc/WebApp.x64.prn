37773>>>    Procedure SetActionButtons
37776>>>        tWebNavigateData NavigateData
37776>>>        tWebNavigateData NavigateData
37776>>>        Boolean bHasRecord
37776>>>        Handle hoDD
37776>>>
37776>>>        Get Server to hoDD
37777>>>        Get GetNavigateData to NavigateData
37778>>>        Get HasRecord of hoDD to bHasRecord
37779>>>
37779>>>        // let's hide all buttons and then Show the ones we want
37779>>>        WebSet pbRender of oEditBtn to False
37780>>>        WebSet pbRender of oSaveBtn to False
37781>>>        WebSet pbRender of oCancelChangesBtn to False
37782>>>        WebSet pbRender of oDeleteBtn to False
37783>>>
37783>>>        If (NavigateData.bReadOnly) Begin
37785>>>            WebSet pbRender of oEditBtn to True
37786>>>        End
37786>>>>
37786>>>        Else Begin
37787>>>            WebSet pbRender of oSaveBtn to True
37788>>>            WebSet pbRender of oCancelChangesBtn to True
37789>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37790>>>        End
37790>>>>
37790>>>    End_Procedure

37729>>>    Procedure SetActionButtons
37732>>>        tWebNavigateData NavigateData
37732>>>        tWebNavigateData NavigateData
37732>>>        Boolean bHasRecord
37732>>>        Handle hoDD
37732>>>
37732>>>        Get Server to hoDD
37733>>>        Get GetNavigateData to NavigateData
37734>>>        Get HasRecord of hoDD to bHasRecord
37735>>>
37735>>>        // let's hide all buttons and then Show the ones we want
37735>>>        WebSet pbRender of oEditBtn to False
37736>>>        WebSet pbRender of oSaveBtn to False
37737>>>        WebSet pbRender of oCancelChangesBtn to False
37738>>>        WebSet pbRender of oDeleteBtn to False
37739>>>
37739>>>        If (NavigateData.bReadOnly) Begin
37741>>>            WebSet pbRender of oEditBtn to True
37742>>>        End
37742>>>>
37742>>>        Else Begin
37743>>>            WebSet pbRender of oSaveBtn to True
37744>>>            WebSet pbRender of oCancelChangesBtn to True
37745>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37746>>>        End
37746>>>>
37746>>>    End_Procedure

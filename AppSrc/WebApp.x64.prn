37834>>>
37834>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37837>>>        Case Begin
37837>>>            Case (NavigateData.eNavigateType = nfFromMain)
37839>>>                // If from main, this is a propbably a main file Select to Zoom.
37839>>>                Send ShowInfoBox "Llegando al zoomEntrenador desde select"
37840>>>                Case Break
37841>>>
37841>>>            Case (NavigateData.eNavigateType = nfFromParent)
37844>>>                // If from parent, this is a constrained drill down.
37844>>>                Case Break
37845>>>
37845>>>            Case (NavigateData.eNavigateType = nfFromChild)
37848>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37848>>>                Case Break
37849>>>
37849>>>            Case Else // must be nfUndefined
37849>>>
37849>>>        Case End
37849>>>        
37849>>>        If (HasRecord(Server(Self))) Begin
37851>>>            Send SetHeaderCaption ("Entrenador:" *entrenador.Nombre)
37852>>>            Send SetBreadcrumbCaption (entrenador.Nombre * entrenador.Apellido)
37853>>>        End
37853>>>>
37853>>>        Else Begin
37854>>>            Send SetHeaderCaption ("Nuevo Entrenador")
37855>>>            Send SetBreadcrumbCaption ("Nuevo")
37856>>>        End
37856>>>>
37856>>>
37856>>>        Send SetActionButtons
37857>>>
37857>>>    End_Procedure
37858>>>
37858>>>End_Object 

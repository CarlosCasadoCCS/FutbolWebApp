38427>>>    Procedure SetActionButtons
38430>>>        tWebNavigateData NavigateData
38430>>>        tWebNavigateData NavigateData
38430>>>        Boolean bHasRecord
38430>>>        Handle hoDD
38430>>>
38430>>>        Get Server to hoDD
38431>>>        Get GetNavigateData to NavigateData
38432>>>        Get HasRecord of hoDD to bHasRecord
38433>>>
38433>>>        // let's hide all buttons and then Show the ones we want
38433>>>        WebSet pbRender of oEditBtn to False
38434>>>        WebSet pbRender of oSaveBtn to False
38435>>>        WebSet pbRender of oCancelChangesBtn to False
38436>>>        WebSet pbRender of oDeleteBtn to False
38437>>>
38437>>>        If (NavigateData.bReadOnly) Begin
38439>>>            WebSet pbRender of oEditBtn to True
38440>>>        End
38440>>>>
38440>>>        Else Begin
38441>>>            WebSet pbRender of oSaveBtn to True
38442>>>            WebSet pbRender of oCancelChangesBtn to True
38443>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38444>>>        End
38444>>>>
38444>>>    End_Procedure

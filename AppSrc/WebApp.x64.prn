38448>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38451>>>        Case Begin
38451>>>            Case (NavigateData.eNavigateType = nfFromMain)
38453>>>                // If from main, this is a propbably a main file Select to Zoom.
38453>>>                Case Break
38454>>>
38454>>>            Case (NavigateData.eNavigateType = nfFromParent)
38457>>>                // If from parent, this is a constrained drill down.
38457>>>                Case Break
38458>>>
38458>>>            Case (NavigateData.eNavigateType = nfFromChild)
38461>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38461>>>                Case Break
38462>>>
38462>>>            Case Else // must be nfUndefined
38462>>>
38462>>>        Case End
38462>>>        
38462>>>        If (HasRecord(Server(Self))) Begin
38464>>>            Send SetHeaderCaption ("Jugador:" *jugador.Nombre)
38465>>>            Send SetBreadcrumbCaption (jugador.Nombre * jugador.Apellido)
38466>>>        End
38466>>>>
38466>>>        Else Begin
38467>>>            Send SetHeaderCaption ("Nuevo Jugador")
38468>>>            Send SetBreadcrumbCaption ("Nuevo")
38469>>>        End
38469>>>>
38469>>>
38469>>>        Send SetActionButtons
38470>>>
38470>>>    End_Procedure

37577>>>>>    Function ValidarEquipo Integer iField Number nValue Returns Integer
37579>>>>>        Integer iEquipoActual
37579>>>>>        Integer iEntrenadorActual
37579>>>>>    
37579>>>>>        // Obtener el ID del equipo seleccionado en el DDO padre
37579>>>>>        Get File_Field_Current_Value File_Field equipo.ID to iEquipoActual
37580>>>>>    
37580>>>>>        // Si no hay equipo seleccionado, permitir guardar
37580>>>>>        If (iEquipoActual = 0) Begin
37582>>>>>            Function_Return 0
37583>>>>>        End
37583>>>>>>
37583>>>>>    
37583>>>>>        // Obtener el ID del entrenador que estamos editando
37583>>>>>        Get Field_Current_Value Field entrenador.ID to iEntrenadorActual
37584>>>>>    
37584>>>>>        // Buscar si otro entrenador ya tiene asignado ese equipo
37584>>>>>        Move iEquipoActual to entrenador2.EquipoID
37585>>>>>        Find EQ entrenador2 by Index.3
37586>>>>>>
37586>>>>>    
37586>>>>>        If (Found) Begin
37588>>>>>            // Si el entrenador encontrado es otro, impedir el guardado

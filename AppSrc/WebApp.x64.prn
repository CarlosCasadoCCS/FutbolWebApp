38952>>>>>>>        Case Begin
38952>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38954>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38954>>>>>>>                Case Break
38955>>>>>>>
38955>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38958>>>>>>>                // If from parent, this is a constrained drill down.
38958>>>>>>>                Case Break
38959>>>>>>>
38959>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38962>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38962>>>>>>>                Case Break
38963>>>>>>>
38963>>>>>>>            Case Else // must be nfUndefined
38963>>>>>>>
38963>>>>>>>        Case End
38963>>>>>>>        
38963>>>>>>>        If (HasRecord(Server(Self))) Begin
38965>>>>>>>            Send SetHeaderCaption ("Liga:" *liga.Nombre)
38966>>>>>>>            Send SetBreadcrumbCaption (liga.Nombre)
38967>>>>>>>        End
38967>>>>>>>>
38967>>>>>>>        Else Begin
38968>>>>>>>            Send SetHeaderCaption ("Nueva Liga")
38969>>>>>>>            Send SetBreadcrumbCaption ("Nueva")
38970>>>>>>>        End
38970>>>>>>>>
38970>>>>>>>
38970>>>>>>>        Send SetActionButtons
38971>>>>>>>
38971>>>>>>>    End_Procedure

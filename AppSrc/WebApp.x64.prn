37801>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37804>>>        Case Begin
37804>>>            Case (NavigateData.eNavigateType = nfFromMain)
37806>>>                // If from main, this is a propbably a main file Select to Zoom.
37806>>>                Send ShowInfoBox "Llegando al zoomEntrenador desde select"
37807>>>                Case Break
37808>>>
37808>>>            Case (NavigateData.eNavigateType = nfFromParent)
37811>>>                // If from parent, this is a constrained drill down.
37811>>>                Case Break
37812>>>
37812>>>            Case (NavigateData.eNavigateType = nfFromChild)
37815>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37815>>>                Case Break
37816>>>
37816>>>            Case Else // must be nfUndefined
37816>>>
37816>>>        Case End
37816>>>        
37816>>>        If (HasRecord(Server(Self))) Begin
37818>>>            Send SetHeaderCaption ("Entrenador:" *entrenador.Nombre)
37819>>>            Send SetBreadcrumbCaption (entrenador.Nombre * entrenador.Apellido)
37820>>>        End
37820>>>>
37820>>>        Else Begin
37821>>>            Send SetHeaderCaption ("Nuevo Entrenador")
37822>>>            Send SetBreadcrumbCaption ("Nuevo")
37823>>>        End
37823>>>>
37823>>>
37823>>>        Send SetActionButtons
37824>>>
37824>>>    End_Procedure
37825>>>
37825>>>End_Object 

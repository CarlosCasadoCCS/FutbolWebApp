37757>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37760>>>        Case Begin
37760>>>            Case (NavigateData.eNavigateType = nfFromMain)
37762>>>                // If from main, this is a propbably a main file Select to Zoom.
37762>>>                Send ShowInfoBox "Llegando al zoomEntrenador desde select"
37763>>>                Case Break
37764>>>
37764>>>            Case (NavigateData.eNavigateType = nfFromParent)
37767>>>                // If from parent, this is a constrained drill down.
37767>>>                Case Break
37768>>>
37768>>>            Case (NavigateData.eNavigateType = nfFromChild)
37771>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37771>>>                Case Break
37772>>>
37772>>>            Case Else // must be nfUndefined
37772>>>
37772>>>        Case End
37772>>>        
37772>>>        If (HasRecord(Server(Self))) Begin
37774>>>            Send SetHeaderCaption ("Entrenador:" *entrenador.Nombre)
37775>>>            Send SetBreadcrumbCaption (entrenador.Nombre * entrenador.Apellido)
37776>>>        End
37776>>>>
37776>>>        Else Begin
37777>>>            Send SetHeaderCaption ("Nuevo Entrenador")
37778>>>            Send SetBreadcrumbCaption ("Nuevo")
37779>>>        End
37779>>>>
37779>>>
37779>>>        Send SetActionButtons
37780>>>
37780>>>    End_Procedure
37781>>>
37781>>>End_Object 

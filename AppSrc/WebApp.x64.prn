37734>>>    Procedure SetActionButtons
37737>>>        tWebNavigateData NavigateData
37737>>>        tWebNavigateData NavigateData
37737>>>        Boolean bHasRecord
37737>>>        Handle hoDD
37737>>>
37737>>>        Get Server to hoDD
37738>>>        Get GetNavigateData to NavigateData
37739>>>        Get HasRecord of hoDD to bHasRecord
37740>>>
37740>>>        // let's hide all buttons and then Show the ones we want
37740>>>        WebSet pbRender of oEditBtn to False
37741>>>        WebSet pbRender of oSaveBtn to False
37742>>>        WebSet pbRender of oCancelChangesBtn to False
37743>>>        WebSet pbRender of oDeleteBtn to False
37744>>>
37744>>>        If (NavigateData.bReadOnly) Begin
37746>>>            WebSet pbRender of oEditBtn to True
37747>>>        End
37747>>>>
37747>>>        Else Begin
37748>>>            WebSet pbRender of oSaveBtn to True
37749>>>            WebSet pbRender of oCancelChangesBtn to True
37750>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37751>>>        End
37751>>>>
37751>>>    End_Procedure
37752>>>
37752>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37755>>>        // Close after save
37755>>>        Send NavigateClose Self
37756>>>    End_Procedure
37757>>>
37757>>>    // this will close the view after a delete
37757>>>    Procedure OnViewDeleted Handle hoDDO
37760>>>        Send NavigateClose Self
37761>>>    End_Procedure
37762>>>
37762>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37765>>>        Case Begin
37765>>>            Case (NavigateData.eNavigateType = nfFromMain)
37767>>>                // If from main, this is a propbably a main file Select to Zoom.
37767>>>                Send ShowInfoBox "Llegando al zoomEntrenador desde select"
37768>>>                Case Break
37769>>>
37769>>>            Case (NavigateData.eNavigateType = nfFromParent)
37772>>>                // If from parent, this is a constrained drill down.
37772>>>                Case Break
37773>>>
37773>>>            Case (NavigateData.eNavigateType = nfFromChild)
37776>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37776>>>                Case Break
37777>>>
37777>>>            Case Else // must be nfUndefined
37777>>>
37777>>>        Case End
37777>>>        
37777>>>        If (HasRecord(Server(Self))) Begin
37779>>>            Send SetHeaderCaption ("Entrenador:" *entrenador.Nombre)
37780>>>            Send SetBreadcrumbCaption (entrenador.Nombre * entrenador.Apellido)
37781>>>        End
37781>>>>
37781>>>        Else Begin
37782>>>            Send SetHeaderCaption ("Nuevo Entrenador")
37783>>>            Send SetBreadcrumbCaption ("Nuevo")
37784>>>        End
37784>>>>
37784>>>
37784>>>        Send SetActionButtons
37785>>>
37785>>>    End_Procedure
37786>>>
37786>>>End_Object 

37808>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37811>>>        Case Begin
37811>>>            Case (NavigateData.eNavigateType = nfFromMain)
37813>>>                // If from main, this is a propbably a main file Select to Zoom.
37813>>>                Send ShowInfoBox "Llegando al zoomEntrenador desde select"
37814>>>                Case Break
37815>>>
37815>>>            Case (NavigateData.eNavigateType = nfFromParent)
37818>>>                // If from parent, this is a constrained drill down.
37818>>>                Case Break
37819>>>
37819>>>            Case (NavigateData.eNavigateType = nfFromChild)
37822>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37822>>>                Case Break
37823>>>
37823>>>            Case Else // must be nfUndefined
37823>>>
37823>>>        Case End
37823>>>        
37823>>>        If (HasRecord(Server(Self))) Begin
37825>>>            Send SetHeaderCaption ("Entrenador:" *entrenador.Nombre)
37826>>>            Send SetBreadcrumbCaption (entrenador.Nombre * entrenador.Apellido)
37827>>>        End
37827>>>>
37827>>>        Else Begin
37828>>>            Send SetHeaderCaption ("Nuevo Entrenador")
37829>>>            Send SetBreadcrumbCaption ("Nuevo")
37830>>>        End
37830>>>>
37830>>>
37830>>>        Send SetActionButtons
37831>>>
37831>>>    End_Procedure
37832>>>
37832>>>End_Object 

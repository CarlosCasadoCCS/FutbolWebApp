38921>>>>>>>    Procedure SetActionButtons
38924>>>>>>>        tWebNavigateData NavigateData
38924>>>>>>>        tWebNavigateData NavigateData
38924>>>>>>>        Boolean bHasRecord
38924>>>>>>>        Handle hoDD
38924>>>>>>>
38924>>>>>>>        Get Server to hoDD
38925>>>>>>>        Get GetNavigateData to NavigateData
38926>>>>>>>        Get HasRecord of hoDD to bHasRecord
38927>>>>>>>
38927>>>>>>>        // let's hide all buttons and then Show the ones we want
38927>>>>>>>        WebSet pbRender of oEditBtn to False
38928>>>>>>>        WebSet pbRender of oSaveBtn to False
38929>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38930>>>>>>>        WebSet pbRender of oDeleteBtn to False
38931>>>>>>>
38931>>>>>>>        If (NavigateData.bReadOnly) Begin
38933>>>>>>>            WebSet pbRender of oEditBtn to True
38934>>>>>>>        End
38934>>>>>>>>
38934>>>>>>>        Else Begin
38935>>>>>>>            WebSet pbRender of oSaveBtn to True
38936>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38937>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38938>>>>>>>        End
38938>>>>>>>>
38938>>>>>>>    End_Procedure

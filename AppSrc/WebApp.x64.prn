37780>>>    Procedure SetActionButtons
37783>>>        tWebNavigateData NavigateData
37783>>>        tWebNavigateData NavigateData
37783>>>        Boolean bHasRecord
37783>>>        Handle hoDD
37783>>>
37783>>>        Get Server to hoDD
37784>>>        Get GetNavigateData to NavigateData
37785>>>        Get HasRecord of hoDD to bHasRecord
37786>>>
37786>>>        // let's hide all buttons and then Show the ones we want
37786>>>        WebSet pbRender of oEditBtn to False
37787>>>        WebSet pbRender of oSaveBtn to False
37788>>>        WebSet pbRender of oCancelChangesBtn to False
37789>>>        WebSet pbRender of oDeleteBtn to False
37790>>>
37790>>>        If (NavigateData.bReadOnly) Begin
37792>>>            WebSet pbRender of oEditBtn to True
37793>>>        End
37793>>>>
37793>>>        Else Begin
37794>>>            WebSet pbRender of oSaveBtn to True
37795>>>            WebSet pbRender of oCancelChangesBtn to True
37796>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37797>>>        End
37797>>>>
37797>>>    End_Procedure

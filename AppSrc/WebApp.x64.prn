38399>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38402>>>        Case Begin
38402>>>            Case (NavigateData.eNavigateType = nfFromMain)
38404>>>                // If from main, this is a propbably a main file Select to Zoom.
38404>>>                Case Break
38405>>>
38405>>>            Case (NavigateData.eNavigateType = nfFromParent)
38408>>>                // If from parent, this is a constrained drill down.
38408>>>                Case Break
38409>>>
38409>>>            Case (NavigateData.eNavigateType = nfFromChild)
38412>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38412>>>                Case Break
38413>>>
38413>>>            Case Else // must be nfUndefined
38413>>>
38413>>>        Case End
38413>>>        
38413>>>        If (HasRecord(Server(Self))) Begin
38415>>>            Send SetHeaderCaption ("Jugador:" *jugador.Nombre)
38416>>>            Send SetBreadcrumbCaption (jugador.Nombre * jugador.Apellido)
38417>>>        End
38417>>>>
38417>>>        Else Begin
38418>>>            Send SetHeaderCaption ("Nuevo Jugador")
38419>>>            Send SetBreadcrumbCaption ("Nuevo")
38420>>>        End
38420>>>>
38420>>>
38420>>>        Send SetActionButtons
38421>>>
38421>>>    End_Procedure
38422>>>
38422>>>End_Object 

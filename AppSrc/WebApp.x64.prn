38458>>>        Case Begin
38458>>>            Case (NavigateData.eNavigateType = nfFromMain)
38460>>>                // If from main, this is a propbably a main file Select to Zoom.
38460>>>                Case Break
38461>>>
38461>>>            Case (NavigateData.eNavigateType = nfFromParent)
38464>>>                // If from parent, this is a constrained drill down.
38464>>>                Case Break
38465>>>
38465>>>            Case (NavigateData.eNavigateType = nfFromChild)
38468>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38468>>>                Case Break
38469>>>
38469>>>            Case Else // must be nfUndefined
38469>>>
38469>>>        Case End
38469>>>        
38469>>>        If (HasRecord(Server(Self))) Begin
38471>>>            Send SetHeaderCaption ("Jugador:" *jugador.Nombre)
38472>>>            Send SetBreadcrumbCaption (jugador.Nombre * jugador.Apellido)
38473>>>        End
38473>>>>
38473>>>        Else Begin
38474>>>            Send SetHeaderCaption ("Nuevo Jugador")
38475>>>            Send SetBreadcrumbCaption ("Nuevo")
38476>>>        End
38476>>>>
38476>>>
38476>>>        Send SetActionButtons
38477>>>
38477>>>    End_Procedure

39238>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39241>>>        Case Begin
39241>>>            Case (NavigateData.eNavigateType = nfFromMain)
39243>>>                // If from main, this is a propbably a main file Select to Zoom.
39243>>>                String sValue
39243>>>                Get NamedValueGet NavigateData.NamedValues "Origen" to sValue
39244>>>                If (sValue="Detail") Begin
39246>>>                    Send ShowInfoBox "Vengo del boton detail"
39247>>>                End
39247>>>>
39247>>>                Else Begin
39248>>>                    Send ShowInfoBox "Vengo del boton row"
39249>>>                End
39249>>>>
39249>>>                Case Break
39250>>>
39250>>>            Case (NavigateData.eNavigateType = nfFromParent)
39253>>>                // If from parent, this is a constrained drill down.
39253>>>                Case Break
39254>>>
39254>>>            Case (NavigateData.eNavigateType = nfFromChild)
39257>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39257>>>                Case Break
39258>>>
39258>>>            Case Else // must be nfUndefined
39258>>>
39258>>>        Case End
39258>>>        
39258>>>        If (HasRecord(Server(Self))) Begin
39260>>>            Send SetHeaderCaption ("Equipo:" *equipo.Nombre)
39261>>>            Send SetBreadcrumbCaption (equipo.Nombre)
39262>>>        End
39262>>>>
39262>>>        Else Begin
39263>>>            Send SetHeaderCaption ("Nuevo Equipo")
